# LiveKit project (copy the three values from the LiveKit Cloud "API keys" page)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional. Defaults are in src/agent.ts.
# LIVEKIT_AGENT_NAME=draft
# VOICE_STT_MODEL=deepgram/nova-3
# Speech recognition language at the start of a call. Default: "ru" on the Russian page, "multi" on the English and
# German pages (then locked to Russian on the first clear Russian). Do not set VOICE_STT_LANGUAGE=multi globally:
# it would undo the Russian-page lock. Per page: VOICE_STT_LANGUAGE_RU / _EN / _DE.
# VOICE_STT_LANGUAGE_RU=ru
# VOICE_STT_LANGUAGE_HINT=on          (send Deepgram language_hint ru,en,de while open; had no effect in tests)
# VOICE_STT_KEYTERMS=Centum,Evolution,Smart Ultra,Provedal,Melke   (more product names right, slightly worse phone digits)
# Silence in ms before the visitor's turn ends; dictation values apply while a phone number is asked for or said.
# VOICE_ENDPOINTING_MIN_MS=300
# VOICE_ENDPOINTING_MAX_MS=2500
# VOICE_DICTATION_MIN_MS=1600
# VOICE_DICTATION_MAX_MS=5000
# VOICE_LLM_MODEL=openai/gpt-5.4-mini
# VOICE_TTS_MODEL=inworld/inworld-tts-2
# VOICE_TTS_VOICE_RU=Dmitry
# VOICE_TTS_VOICE_EN=Dennis
# VOICE_TTS_VOICE_DE=Josef

# Optional: use an OpenAI-compatible endpoint as the voice brain instead of LiveKit Inference
# VOICE_LLM_BASE_URL=
# VOICE_LLM_API_KEY=
